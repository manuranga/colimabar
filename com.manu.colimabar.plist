<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.manu.colimabar</string>
    <key>ProgramArguments</key>
    <array>
        <string>@DIR@/installed/ColimaBar.app/Contents/MacOS/colimabar</string>
        <string>@DIR@/.config</string>
    </array>
    <key>StandardErrorPath</key>
    <string>~/Library/Logs/colimabar.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
